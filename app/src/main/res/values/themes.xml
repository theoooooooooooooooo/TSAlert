<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         THÈME PRINCIPAL (mode clair) — mappe les tokens couleurs
         sur les attributs Material. La variante nuit est dans
         values-night/themes.xml.
         ============================================================ -->
    <style name="Theme.TSAlert" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Couleur de marque (bouton SOS, action bar) -->
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryVariant">@color/brand_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Accent secondaire (réutilise le rouge de marque) -->
        <item name="colorSecondary">@color/brand_red</item>
        <item name="colorSecondaryVariant">@color/brand_red_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surfaces et texte -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnBackground">@color/on_surface</item>

        <!-- Barre de statut : rouge foncé, icônes claires lisibles -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Formes : coins arrondis cohérents -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.TSAlert.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TSAlert.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.TSAlert.Large</item>
    </style>

    <!-- ============================================================
         SHAPE APPEARANCES — rayons centralisés (cf. dimens.xml)
         ============================================================ -->
    <style name="ShapeAppearance.TSAlert.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="ShapeAppearance.TSAlert.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="ShapeAppearance.TSAlert.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <!-- Coins à 50% : transforme un bouton carré en cercle parfait.
         parent="" coupe l'héritage implicite (sinon AAPT cherche
         un parent ShapeAppearance.TSAlert qui n'existe pas). -->
    <style name="ShapeAppearance.TSAlert.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
