<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         THÈME PRINCIPAL (mode sombre)
         Mêmes attributs que le thème clair : seules les couleurs
         résolues changent (via values-night/colors.xml).
         ============================================================ -->
    <style name="Theme.TSAlert" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryVariant">@color/brand_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/brand_red</item>
        <item name="colorSecondaryVariant">@color/brand_red_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnBackground">@color/on_surface</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.TSAlert.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TSAlert.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.TSAlert.Large</item>
    </style>

</resources>
